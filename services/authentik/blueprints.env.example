# services/authentik/blueprints.env: the values the blueprints reference with !Env. Loaded by the
# worker only (docker-compose.yml env_file), 0600, never committed; the real file is in 1Password and
# in every backup run (stack-config). After changing a value: `docker compose up -d --no-deps worker`.
AVRANA_JELLYFIN_API_KEY=placeholder-jellyfin-api-key-of-the-enrollment-account-creator
AVRANA_KOMGA_ADMIN_EMAIL=placeholder-komga-admin-login
AVRANA_KOMGA_ADMIN_PASSWORD=placeholder-komga-admin-password
AVRANA_SMTP2GO_PASSWORD=placeholder-smtp2go-smtp-password
AVRANA_OIDC_AUDIBLE_CONNECTOR_CLIENT_SECRET=placeholder-oidc-client-secret
AVRANA_OIDC_AUDIOBOOKSHELF_CLIENT_SECRET=placeholder-oidc-client-secret
AVRANA_OIDC_KOMGA_CLIENT_SECRET=placeholder-oidc-client-secret
AVRANA_OIDC_OMNIBUS_CLIENT_SECRET=placeholder-oidc-client-secret
AVRANA_OIDC_SHELFARR_CLIENT_SECRET=placeholder-oidc-client-secret
