# TEMPLATE. Secret values were removed when this was imported from production on 2026-10-04.
# The deployed file is services/authentik/blueprints/audible-connector.yaml (not in Git, restored from backup).
# docs/SECRETS.md lists each removed value and where it comes from.
version: 1
metadata:
  name: Avrana - Audible Connector OIDC
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  # Group that gates access to the connector. Add contributors to this group.
  - model: authentik_core.group
    id: library-contributors
    identifiers:
      name: library-contributors
    attrs:
      name: library-contributors

  - model: authentik_providers_oauth2.oauth2provider
    id: audible-connector-provider
    identifiers:
      name: audible-connector
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: "1624c68b0c5bf45918e1190314b8f7b011437125"
      client_secret: "<SECRET - not in Git; see docs/SECRETS.md>"
      redirect_uris:
        - matching_mode: strict
          url: https://contribute.avrana.net/auth/callback
          redirect_uri_type: authorization
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]

  - model: authentik_core.application
    id: audible-connector-app
    identifiers:
      slug: audible-connector
    attrs:
      # Reminder: the tile can't shrink text (shadow DOM), so a multi-word name may wrap to
      # two lines. Category = Contribute.
      name: Add my Audible
      group: Contribute
      provider: !KeyOf audible-connector-provider
      meta_launch_url: https://contribute.avrana.net/contribute/audible

  # Gate the app to library-contributors only.
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf audible-connector-app
      group: !KeyOf library-contributors
      order: 0
    attrs:
      enabled: true
