# Copy to .env (gitignored) and fill in. Never commit real values.
#
# Jellyfin: Dashboard -> API Keys -> new key named "olivetin".
# Jellyfin uses host networking, so it is reached by LAN IP, not a container name.
JELLYFIN_URL=http://10.0.0.218:8096
JELLYFIN_API_KEY=

# Audiobookshelf: Settings -> Users -> your admin user -> API token.
ABS_URL=http://10.0.0.218:13378
ABS_API_KEY=
