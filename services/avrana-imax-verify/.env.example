# Variable names only. Values live in the deployed .env (mode 0600) and in 1Password.
# Generated from production on 2026-10-04; see docs/SECRETS.md.
RADARR_API_KEY=
JELLYFIN_API_KEY=
# Basic-auth password Radarr's Webhook connection must send (user: radarr). Generate with
# `openssl rand -hex 24`, enter the same value in Radarr > Settings > Connect > the webhook, then
# set IMAX_WEBHOOK_AUTH=required. Until then "warn" accepts and logs unauthenticated posts.
IMAX_WEBHOOK_PASSWORD=
IMAX_WEBHOOK_AUTH=warn
