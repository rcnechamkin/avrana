{
  "schema_version": 1,
  "status": "proposed, not approved, nothing deployed",
  "description": "Approved-corpus PROPOSAL for the Avrana Assistant (AVR-397). Member-safe content only, derived from files in this repository. Staleness: blob = git blob hash of the source file at extraction; anchor_text must still occur in the source.",
  "gaps": [
    {
      "id": "G-1",
      "gap": "No live service status source",
      "owner_decision": "Operator notice banner (MEDIA-2.0 M1) or sanitized status adapter (AVR-411)"
    },
    {
      "id": "G-2",
      "gap": "Repo is contradictory about whether e-mail password recovery is live",
      "owner_decision": "SMTP credential rotation and a verified end-to-end recovery test"
    },
    {
      "id": "G-3",
      "gap": "Welcome guide recommends Wholphin; portal HELP lists plain Jellyfin for the same TVs",
      "owner_decision": "Choose the recommended TV app and fix the stale source"
    },
    {
      "id": "G-4",
      "gap": "Home page address: portal and Media 2.0 say avrana.net, welcome guide says auth.avrana.net",
      "owner_decision": "Confirm the member home address"
    },
    {
      "id": "G-5",
      "gap": "No member-facing steps or turnaround for the book and comic request services",
      "owner_decision": "Write member help for requestabook and requestacomic"
    },
    {
      "id": "G-6",
      "gap": "Send-to-Kindle sender address exists only as a named e-mail in portal.py",
      "owner_decision": "Decide whether the assistant may state it"
    },
    {
      "id": "G-7",
      "gap": "Support contact route (decision D-1 in MEDIA-2.0)",
      "owner_decision": "D-1"
    }
  ],
