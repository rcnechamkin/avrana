# Avrana Home OWNER PREVIEW: non-secret settings. Copy to preview.env (gitignored) and fill in.
# NO secrets in this file: keys, tokens and passwords live in ./secrets/ files (mode 0600) and are named
# below by their /run/secrets path only. Runbook: docs/runbooks/home-owner-preview.md.

# Real upstreams. HOME_GATES_VERIFIED must NOT be set: the preview does not verify G1/G2; it replaces
# every identity header instead (settings.py refuses the two together).
HOME_UPSTREAM_MODE=real
LOG_LEVEL=INFO

# Who the preview shows: the owner, always (a client can never choose). The groups are the library
# groups the adapters check (contract.REQUIRED_GROUP) plus avrana-users; nothing else is accepted.
PREVIEW_OWNER_USERNAME=<owner-authentik-username, e.g. akadmin>
PREVIEW_OWNER_GROUPS=avrana-users|avrana-videos|avrana-audiobooks|avrana-comics|avrana-books

# The owner's account name in each service, when it differs from PREVIEW_OWNER_USERNAME. Matched EXACTLY
# (case-sensitive), for the owner's principal only. Leave empty to use PREVIEW_OWNER_USERNAME.
HOME_JELLYFIN_USERNAME=<owner-jellyfin-username, e.g. Cody>
HOME_AUDIOBOOKSHELF_USERNAME=<owner-audiobookshelf-username, e.g. akadmin>

# Jellyfin runs on the host network (:8096). From this container use the host's LAN address.
JELLYFIN_BASE_URL=http://10.0.0.218:8096
JELLYFIN_API_KEY_FILE=/run/secrets/jellyfin_api_key

# Audiobookshelf (LAN-bound container). The token is admin-capable (an open gate: see the runbook).
AUDIOBOOKSHELF_BASE_URL=http://10.0.0.218:13378
AUDIOBOOKSHELF_TOKEN_FILE=/run/secrets/audiobookshelf_token

# Calibre-Web (shared viewer account, "user:password" in the secret file). Owner decision: no member
# restrictions, so the confirmation below is the owner's statement; remove all three lines to leave it out.
CALIBRE_WEB_BASE_URL=http://10.0.0.218:8083
CALIBRE_WEB_CREDENTIAL_FILE=/run/secrets/calibre_web_credential
CALIBRE_WEB_OWNER_CONFIRMS_NO_MEMBER_RESTRICTIONS=<yes, only if you confirm it>

# Komga (shared regular-account view, PR #50). cloudflared reaches it at localhost:25600, so it may be
# bound to 127.0.0.1 on the host and then UNREACHABLE from this container. Verify at deploy before
# enabling; until then leave these three lines commented out.
# KOMGA_BASE_URL=http://<address reachable from the container>:25600
# KOMGA_TOKEN_FILE=/run/secrets/komga_token
# KOMGA_OWNER_CONFIRMS_NO_MEMBER_RESTRICTIONS=<yes, only if you confirm it>
