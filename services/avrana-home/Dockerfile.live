# Avrana Home LIVE image: the application exactly as serve.py runs it, for the live-data beta
# (docker-compose.beta-live.yml, AVR-771) and later the member release. NOT DEPLOYED; building it changes
# nothing live.
#
# Build (from services/avrana-home; the named context "portal" supplies the portal's route tables):
#   docker build -f Dockerfile.live --build-context portal=../avrana-portal -t avrana-home-live:local .
#
# Base image: the SAME pinned digest as Dockerfile.preview, Dockerfile.beta and services/avrana-portal/Dockerfile.
# Contents (Dockerfile.live.dockerignore denies everything else): the hash-checked dependencies and avrana_home/
# only. Never dev/ (mocks, the development identity shim), preview/ (the password gate and owner seal), beta/,
# tests/, webtests/, contracts/ or secrets.
FROM python:3.12-slim@sha256:dd29372629eeba2dd003fd9e9d35a5b8236c44727875a0364254b5127af88e65
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: -r /app/requirements.lock
COPY avrana_home/ /app/avrana_home/
COPY --from=portal portal.py /app/catalogue/portal.py
# Binds 0.0.0.0 INSIDE the container only; the compose file publishes no host port (outpost network only).
ENV HOME_HOST=0.0.0.0 HOME_PORT=8096 HOME_CATALOGUE_PATH=/app/catalogue/portal.py HOME_HEALTH_DETAIL=off
USER 1000:1000
EXPOSE 8096
HEALTHCHECK --interval=30s --timeout=4s --start-period=10s --retries=3 \
  CMD python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8096/healthz',timeout=3).status==200 else 1)"
CMD ["python3", "-m", "avrana_home.app.serve"]
