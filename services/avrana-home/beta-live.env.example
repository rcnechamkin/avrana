# Avrana Home LIVE-DATA BETA: non-secret settings. Copy to beta-live.env (gitignored) next to
# docker-compose.beta-live.yml. Secrets go in ./secrets/ files, never here. Runbook: docs/runbooks/home-beta-live.md.

# From the Authentik admin UI, the BETA proxy provider (not the portal's): Applications -> Providers ->
# avrana-home-beta-proxy. Issuer is its "OpenID Configuration Issuer"; audience is its Client ID.
HOME_JWT_ISSUER=<issuer URL of the avrana-home-beta-proxy provider>
HOME_JWT_AUDIENCE=<client id of the avrana-home-beta-proxy provider>

# Second lock behind the avrana-beta group: the ONE Authentik username that may use the live beta. Pick an
# account whose username is EXACTLY its Jellyfin and Audiobookshelf username (case-sensitive), preferably a
# non-admin member account (AVR-771), and add it to the avrana-beta group.
HOME_ALLOWED_USERS=<the tester's Authentik username>
